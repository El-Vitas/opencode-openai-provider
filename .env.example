HOST=localhost
PORT=3000
API_KEY=your-api-key
DEFAULT_MODEL=openai/gpt-4o

# Optional: connect to external OpenCode server
# OPENCODE_BASE_URL=http://localhost:4096
# OPENCODE_SERVER_PASSWORD=dev-key
# OPENCODE_SERVER_USERNAME=opencode

# API_KEY protects this provider endpoint (client -> provider).
# OPENCODE_SERVER_PASSWORD protects OpenCode (provider -> OpenCode).

# Provider API keys (auto-detected by *_API_KEY pattern)
# OPENAI_API_KEY=sk-...
# GITHUB_COPILOT_API_KEY=github_...
# ANTHROPIC_API_KEY=sk-ant-...
